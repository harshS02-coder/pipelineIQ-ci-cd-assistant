# ==============================================================================
# PipelineIQ Backend — Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to version control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
HOST=localhost
CORS_ORIGIN=*

# Webhook Base URL (for GitHub OAuth redirect and webhook ingestion)
# In development with ngrok/localtunnel, use your public tunnel URL: e.g. https://xyz.ngrok-free.app
WEBHOOK_BASE_URL=http://localhost:3000

# Database (MongoDB)
MONGODB_URI=mongodb://root:password@localhost:27017/llm-devops-assistant?authSource=admin
MONGODB_USER=root
MONGODB_PASSWORD=password

# Redis / Bull Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Secrets
# JWT Secret for session tokens
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# API Key for header authentication (X-API-Key)
API_KEY_HEADER=X-API-Key
API_KEY=your-api-key-for-api-authentication

# Token Encryption Key (AES-256-GCM) — Must be exactly 64 hex characters (32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your-64-character-hex-encryption-key-here

# GitHub OAuth App Credentials
# Create at https://github.com/settings/developers -> OAuth Apps
# Authorization callback URL: http://localhost:3000/api/v1/github/callback
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# LLM Engine Configuration
# Choose one of: groq, openai, anthropic, gemini, ollama
LLM_PROVIDER=groq

# Groq Configuration (Recommended for sub-second inference)
GROQ_API_KEY=gsk_your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Configuration (Alternative)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-openai-api-key
# OPENAI_MODEL=gpt-4-turbo
# OPENAI_TEMPERATURE=0.7

# Anthropic Claude Configuration (Alternative)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Google Gemini Configuration (Alternative)
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-1.5-pro

# Local Ollama Configuration (Alternative)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama2

# Fix Engine Guardrails
ENABLE_AUTO_FIX=true
ENABLE_SAFE_FIX_ONLY=true
MAX_FIX_RETRY_ATTEMPTS=3

# Rate Limiting & Queue Tuning
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
QUEUE_MAX_WORKERS=5
QUEUE_MAX_ATTEMPTS=3

# Logging
LOG_LEVEL=info
